{
  "consumer": {
    "name": "TaskFlowCommentsClient"
  },
  "interactions": [
    {
      "description": "a request for the comments of task-1",
      "providerStates": [
        {
          "name": "task-1 exists and has comments visible to Ana"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer token-example"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/tasks/task-1/comments"
      },
      "response": {
        "body": [
          {
            "body": "Primer comentario",
            "createdAt": "2026-10-20T00:00:00.000Z",
            "id": "comment-1",
            "taskId": "task-1"
          }
        ],
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].body": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].createdAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss.SSSX",
                  "match": "datetime"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^comment-\\d+$"
                }
              ]
            },
            "$[*].taskId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^task-1$"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "15.0.1"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "TaskFlowAPI"
  }
}